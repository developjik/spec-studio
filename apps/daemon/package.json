    "@spec-studio/protocol": "workspace:*",
    "@spec-studio/publish": "workspace:*",
    "@spec-studio/store": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
