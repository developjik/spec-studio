{
  "name": "@spec-studio/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Loopback HTTP API over the local SQLite project — the only writer the browser talks to",
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/daemon.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@spec-studio/ai": "workspace:*",
