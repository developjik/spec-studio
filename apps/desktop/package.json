{
  "name": "@spec-studio/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell: window + app:// protocol + daemon sidecar. No runtime dependencies.",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron .",
    "smoke": "node scripts/smoke.mjs",
    "package:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "~7.0.2"
  }
}
